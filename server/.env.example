# Copy to .env and fill in. Never commit .env. See README.md for each value.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# Name the database explicitly; without one MongoDB uses "test".
MONGO_URI=mongodb://localhost:27017/vista

JWT_SECRET=
JWT_EXPIRE=1h

ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Gmail address and a Google app password (not the account password)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Sudo admin (npm run setup-admin). ADMIN_EMPLOYEE_ID makes an admin the sudo admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_SCHOOL=SCOPE
ADMIN_DEPARTMENT=CSE

# Optional
# EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v2.0
# SIMILARITY_FLAG_THRESHOLD=75
# SIMILARITY_REJECT_THRESHOLD=93
# SIMILARITY_REFERENCE_FLAG_THRESHOLD=70
