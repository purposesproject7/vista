# ================================
# MONGODB CONFIGURATION
# ================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-mongodb-password-here
# Host port for external MongoDB access (randomized by deploy.sh)
# Internal container port is always 27017
MONGO_HOST_PORT=27017

# ================================
# SERVER CONFIGURATION
# ================================
PORT=5000
NODE_ENV=production

# ================================
# JWT SECRET
# ================================
# IMPORTANT: Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-here

# ================================
# CORS ALLOWED ORIGINS
# ================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5000

# ================================
# EMAIL CONFIGURATION
# ================================
# Email service credentials for sending notifications
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password-here
EMAIL_FROM=Vista System <your-email@example.com>

# ================================
# ADMIN CREDENTIALS
# ================================
# Initial admin account details
ADMIN_EMAIL=admin@vit.ac.in
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=System Administrator
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_SCHOOL=SCOPE
ADMIN_DEPARTMENT=CSE

# ================================
# OPTIONAL: DUMMY TEST ACCOUNTS (QA/staging only — leave unset in production)
# ================================
# Populates 2 faculty, 1 project coordinator, and 2 student burner accounts
# via `npm run setup-test-accounts` (server/scripts/setupTestAccounts.js).
# Faculty/coordinator emails must end in @vit.ac.in, student emails in @vitstudent.ac.in.
# TEST_ACCOUNTS_SCHOOL=SCOPE
# TEST_ACCOUNTS_PROGRAM=CSE
# TEST_ACCOUNTS_ACADEMIC_YEAR=2024-2025
#
# TEST_FACULTY1_EMAIL=testfaculty1@vit.ac.in
# TEST_FACULTY1_PASSWORD=change-this-password
# TEST_FACULTY1_NAME=Test Faculty One
# TEST_FACULTY1_EMPLOYEE_ID=TESTFAC001
#
# TEST_FACULTY2_EMAIL=testfaculty2@vit.ac.in
# TEST_FACULTY2_PASSWORD=change-this-password
# TEST_FACULTY2_NAME=Test Faculty Two
# TEST_FACULTY2_EMPLOYEE_ID=TESTFAC002
#
# TEST_COORDINATOR_EMAIL=testcoordinator@vit.ac.in
# TEST_COORDINATOR_PASSWORD=change-this-password
# TEST_COORDINATOR_NAME=Test Project Coordinator
# TEST_COORDINATOR_EMPLOYEE_ID=TESTPC001
#
# TEST_STUDENT1_EMAIL=teststudent1@vitstudent.ac.in
# TEST_STUDENT1_PASSWORD=change-this-password
# TEST_STUDENT1_NAME=Test Student One
# TEST_STUDENT1_REGNO=23TESTCSE001
#
# TEST_STUDENT2_EMAIL=teststudent2@vitstudent.ac.in
# TEST_STUDENT2_PASSWORD=change-this-password
# TEST_STUDENT2_NAME=Test Student Two
# TEST_STUDENT2_REGNO=23TESTCSE002

# ================================
# OPTIONAL: MONGODB ATLAS
# ================================
# If you want to use MongoDB Atlas instead of local MongoDB,
# uncomment and set this variable. It will override the local MongoDB.
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/vista?retryWrites=true&w=majority
